<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.dylan.personalhub.mapper.EducationMapper">


    <select id="findAll"
            resultType="com.dylan.personalhub.entity.Education">


        SELECT

            id,
            school,
            major,
            degree,
            start_time,
            end_time,
            description

        FROM education

        ORDER BY start_time DESC


    </select>


</mapper>