<?xml version="1.0" encoding="UTF-8" ?>


<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.dylan.personalhub.mapper.ArticleMapper">


    <select id="findAll"
            resultType="com.dylan.personalhub.entity.Article">


        SELECT

            id,

            title,

            summary,

            content,

            category,

            cover,

            create_time,

            update_time


        FROM article


        ORDER BY create_time DESC


    </select>



    <select id="findById"
            resultType="com.dylan.personalhub.entity.Article">


        SELECT

            id,

            title,

            summary,

            content,

            category,

            cover,

            create_time,

            update_time


        FROM article


        WHERE id=#{id}


    </select>


</mapper>