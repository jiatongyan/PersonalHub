<?xml version="1.0" encoding="UTF-8" ?>


<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.dylan.personalhub.mapper.SkillMapper">


    <select id="findAll"
            resultType="com.dylan.personalhub.entity.Skill">


        SELECT

            id,

            name,

            level,

            category,

            description


        FROM skill


        ORDER BY level DESC


    </select>

    <select id="findById"
            resultType="com.dylan.personalhub.entity.Skill">

        SELECT

            id,

            name,

            level,

            category,

            description

        FROM skill

        WHERE id = #{id}

    </select>


    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO skill
        (
            name,
            level,
            category,
            description
        )
        VALUES
            (
                #{name},
                #{level},
                #{category},
                #{description}
            )
    </insert>


    <update id="update">
        UPDATE skill
        SET
            name        = #{name},
            level       = #{level},
            category    = #{category},
            description = #{description}
        WHERE id = #{id}
    </update>


    <delete id="deleteById">
        DELETE FROM skill
        WHERE id = #{id}
    </delete>


</mapper>